{"timestamp": "2026-09-16T06:53:20.187235", "query": "SELECT TOP 15 T0.\"DocNum\", T0.\"DocDate\", T0.\"CardCode\", T0.\"CardName\", T0.\"DocStatus\", TO_VARCHAR(IFNULL(T0.\"DocTotal\", 0)) AS \"DocTotal\" FROM \"ORDR\" T0 WHERE EXTRACT(YEAR FROM T0.\"DocDate\") = 2025 ORDER BY T0.\"DocDate\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-16T08:05:04.081336", "query": "SELECT TO_VARCHAR(IFNULL(SUM(T0.\"DocTotal\"), 0)) AS \"TotalRevenue\" FROM \"OINV\" T0 WHERE T0.\"CANCELED\" = 'N' AND EXTRACT(YEAR FROM T0.\"DocDate\") = EXTRACT(YEAR FROM CURRENT_DATE) AND EXTRACT(MONTH FROM T0.\"DocDate\") IN (11, 12)", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-16T08:05:48.198118", "query": "SELECT EXTRACT(MONTH FROM T0.\"DocDate\") AS \"Month\", EXTRACT(YEAR FROM T0.\"DocDate\") AS \"Year\", TO_VARCHAR(IFNULL(SUM(T0.\"DocTotal\"), 0)) AS \"Revenue\" FROM OINV T0 WHERE T0.\"CANCELED\" = 'N' AND EXTRACT(YEAR FROM T0.\"DocDate\") = EXTRACT(YEAR FROM CURRENT_DATE) GROUP BY EXTRACT(MONTH FROM T0.\"DocDate\"), EXTRACT(YEAR FROM T0.\"DocDate\") ORDER BY \"Month\" ASC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-16T08:25:53.077662", "query": "SELECT TO_VARCHAR(IFNULL(SUM(T0.\"DocTotal\"), 0)) AS \"Revenue\", EXTRACT(YEAR FROM T0.\"DocDate\") AS \"Year\", EXTRACT(MONTH FROM T0.\"DocDate\") AS \"Month\" FROM OINV T0 WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocDate\" >= ADD_MONTHS(CURRENT_DATE, -2) AND T0.\"DocDate\" < CURRENT_DATE GROUP BY EXTRACT(YEAR FROM T0.\"DocDate\"), EXTRACT(MONTH FROM T0.\"DocDate\") ORDER BY \"Year\" ASC, \"Month\" ASC", "status": "SUCCESS", "details": ""}

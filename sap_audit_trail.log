{"timestamp": "2026-09-21T11:52:08.677310", "query": "SELECT TOP 20 YEAR(T0.\"DocDate\") AS \"Year\", MONTH(T0.\"DocDate\") AS \"MonthNum\", CASE MONTH(T0.\"DocDate\") WHEN 1 THEN 'Jan' WHEN 2 THEN 'Feb' WHEN 3 THEN 'Mar' WHEN 4 THEN 'Apr' WHEN 5 THEN 'May' WHEN 6 THEN 'Jun' WHEN 7 THEN 'Jul' WHEN 8 THEN 'Aug' WHEN 9 THEN 'Sep' WHEN 10 THEN 'Oct' WHEN 11 THEN 'Nov' WHEN 12 THEN 'Dec' END AS \"Month\", ROUND(SUM(T0.\"DocTotal\") / 10000000, 2) AS \"Sales_Revenue_Cr\" FROM OINV T0 WHERE T0.\"CANCELED\" = 'N' AND YEAR(T0.\"DocDate\") BETWEEN 2022 AND 2026 GROUP BY YEAR(T0.\"DocDate\"), MONTH(T0.\"DocDate\") ORDER BY YEAR(T0.\"DocDate\"), MONTH(T0.\"DocDate\")", "status": "SUCCESS", "details": ""}

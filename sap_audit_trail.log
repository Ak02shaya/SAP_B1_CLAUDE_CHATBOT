{"timestamp": "2026-09-16T10:45:36.403775", "query": "SELECT TOP 2 EXTRACT(YEAR FROM T0.\"DocDate\") AS \"Year\", EXTRACT(MONTH FROM T0.\"DocDate\") AS \"Month\", TO_VARCHAR(IFNULL(SUM(T0.\"DocTotal\"), 0)) AS \"TotalRevenue\", TO_VARCHAR(IFNULL(SUM(T0.\"GrosProfit\"), 0)) AS \"TotalGrossProfit\", COUNT(T0.\"DocEntry\") AS \"InvoiceCount\" FROM OINV T0 WHERE T0.\"CANCELED\" = 'N' GROUP BY EXTRACT(YEAR FROM T0.\"DocDate\"), EXTRACT(MONTH FROM T0.\"DocDate\") ORDER BY \"Year\" DESC, \"Month\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-16T10:49:06.810554", "query": "SELECT EXTRACT(MONTH FROM T0.\"DocDate\") AS \"Month\", EXTRACT(YEAR FROM T0.\"DocDate\") AS \"Year\", TO_VARCHAR(IFNULL(SUM(T0.\"DocTotal\"), 0)) AS \"TotalRevenue\", TO_VARCHAR(IFNULL(SUM(T1.\"GrssProfit\"), 0)) AS \"GrossProfit\", TO_VARCHAR(COUNT(DISTINCT T0.\"DocEntry\")) AS \"InvoiceCount\" FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" WHERE T0.\"CANCELED\" = 'N' AND EXTRACT(YEAR FROM T0.\"DocDate\") = 2025 GROUP BY EXTRACT(YEAR FROM T0.\"DocDate\"), EXTRACT(MONTH FROM T0.\"DocDate\") ORDER BY \"Month\" ASC", "status": "SUCCESS", "details": ""}

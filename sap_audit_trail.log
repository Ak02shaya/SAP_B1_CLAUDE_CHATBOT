{"timestamp": "2026-09-22T06:43:25.841683", "query": "SELECT TOP 50 T0.\"CardCode\" AS \"Customer Code\", T0.\"CardName\" AS \"Customer Name\", COUNT(DISTINCT T0.\"DocNum\") AS \"Total Orders\", SUM(T0.\"DocTotal\") AS \"Total Sales Value\", SUM(T0.\"DocTotal\") / COUNT(DISTINCT T0.\"DocNum\") AS \"Avg Order Value\", MIN(T0.\"DocDate\") AS \"First Purchase Date\", MAX(T0.\"DocDate\") AS \"Last Purchase Date\" FROM OINV T0 WHERE T0.\"CANCELED\" = 'N' GROUP BY T0.\"CardCode\", T0.\"CardName\" HAVING COUNT(DISTINCT T0.\"DocNum\") > 1 ORDER BY COUNT(DISTINCT T0.\"DocNum\") DESC, SUM(T0.\"DocTotal\") DESC", "status": "SUCCESS", "details": ""}

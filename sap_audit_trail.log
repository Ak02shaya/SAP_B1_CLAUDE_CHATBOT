{"timestamp": "2026-09-22T10:02:55.532628", "query": "SELECT TOP 20 OG.\"ItmsGrpNam\" FROM OITB OG WHERE OG.\"ItmsGrpNam\" LIKE '%CARRY BAG%' OR OG.\"ItmsGrpNam\" LIKE '%EARPHONE%' OR OG.\"ItmsGrpNam\" LIKE '%CHARGER%' OR OG.\"ItmsGrpNam\" LIKE '%WATCH%' OR OG.\"ItmsGrpNam\" LIKE '%BUDS%' OR OG.\"ItmsGrpNam\" LIKE '%TWS%' OR OG.\"ItmsGrpNam\" LIKE '%BACK COVER%' OR OG.\"ItmsGrpNam\" LIKE '%SCREEN%' OR OG.\"ItmsGrpNam\" LIKE '%CABLE%' OR OG.\"ItmsGrpNam\" LIKE '%POWER BANK%'", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-22T10:03:16.491389", "query": "SELECT CASE WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-VIVO%' THEN 'VIVO' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-OPPO%' THEN 'OPPO' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-XIAOMI%' THEN 'XIAOMI' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-SAMSUNG%' THEN 'SAMSUNG' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-APPLE%' THEN 'APPLE' END AS MobileBrand, COUNT(DISTINCT T0.\"DocEntry\") AS TotalPhoneInvoices, COUNT(DISTINCT T0.\"CardCode\") AS UniqueCustomers, SUM(T1.\"Quantity\") AS TotalPhoneUnitsSold FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OITM T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN OITB OG ON T2.\"ItmsGrpCod\" = OG.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND ( OG.\"ItmsGrpNam\" LIKE 'MOB-VIVO%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-OPPO%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-XIAOMI%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-SAMSUNG%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-APPLE%' ) GROUP BY CASE WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-VIVO%' THEN 'VIVO' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-OPPO%' THEN 'OPPO' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-XIAOMI%' THEN 'XIAOMI' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-SAMSUNG%' THEN 'SAMSUNG' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-APPLE%' THEN 'APPLE' END ORDER BY TotalPhoneInvoices DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-22T10:03:16.683100", "query": "SELECT CASE WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-VIVO%' THEN 'VIVO' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-OPPO%' THEN 'OPPO' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-XIAOMI%' THEN 'XIAOMI' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-SAMSUNG%' THEN 'SAMSUNG' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-APPLE%' THEN 'APPLE' END AS MobileBrand, COUNT(DISTINCT T0.\"DocEntry\") AS InvoicesWithAccessory, SUM(T3.\"Quantity\") AS TotalAccessoryUnits, COUNT(DISTINCT OG2.\"ItmsGrpNam\") AS DistinctAccessoryCategories FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OITM T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN OITB OG ON T2.\"ItmsGrpCod\" = OG.\"ItmsGrpCod\" INNER JOIN INV1 T3 ON T0.\"DocEntry\" = T3.\"DocEntry\" INNER JOIN OITM T4 ON T3.\"ItemCode\" = T4.\"ItemCode\" INNER JOIN OITB OG2 ON T4.\"ItmsGrpCod\" = OG2.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND ( OG.\"ItmsGrpNam\" LIKE 'MOB-VIVO%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-OPPO%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-XIAOMI%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-SAMSUNG%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-APPLE%' ) AND ( OG2.\"ItmsGrpNam\" LIKE '%CARRY BAG%' OR OG2.\"ItmsGrpNam\" LIKE '%EARPHONE%' OR OG2.\"ItmsGrpNam\" LIKE '%CHARGER%' OR OG2.\"ItmsGrpNam\" LIKE '%WATCH%' OR OG2.\"ItmsGrpNam\" LIKE '%BUDS%' OR OG2.\"ItmsGrpNam\" LIKE '%TWS%' OR OG2.\"ItmsGrpNam\" LIKE '%BACK COVER%' OR OG2.\"ItmsGrpNam\" LIKE '%SCREEN%' OR OG2.\"ItmsGrpNam\" LIKE '%CABLE%' OR OG2.\"ItmsGrpNam\" LIKE '%POWER BANK%' OR OG2.\"ItmsGrpNam\" LIKE '%INSURANCE%' OR OG2.\"ItmsGrpNam\" LIKE '%BAG PACK%' ) GROUP BY CASE WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-VIVO%' THEN 'VIVO' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-OPPO%' THEN 'OPPO' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-XIAOMI%' THEN 'XIAOMI' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-SAMSUNG%' THEN 'SAMSUNG' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-APPLE%' THEN 'APPLE' END ORDER BY InvoicesWithAccessory DESC", "status": "API_ERROR", "details": "VZone API Error: 404 - <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\"/>\r\n<title>404 - File or directory not found.</title>\r\n<style type=\"text/css\">\r\n<!--\r\nbody{margin:0;font-size:.7em;font-family:Verdana, Arial, Helvetica, sans-serif;background:#EEEEEE;}\r\nfieldset{padding:0 15px 10px 15px;} \r\nh1{font-size:2.4em;margin:0;color:#FFF;}\r\nh2{font-size:1.7em;margin:0;color:#CC0000;} \r\nh3{font-size:1.2em;margin:10px 0 0 0;color:#000000;} \r\n#header{width:96%;margin:0 0 0 0;padding:6px 2% 6px 2%;font-family:\"trebuchet MS\", Verdana, sans-serif;color:#FFF;\r\nbackground-color:#555555;}\r\n#content{margin:0 0 0 2%;position:relative;}\r\n.content-container{background:#FFF;width:96%;margin-top:8px;padding:10px;position:relative;}\r\n-->\r\n</style>\r\n</head>\r\n<body>\r\n<div id=\"header\"><h1>Server Error</h1></div>\r\n<div id=\"content\">\r\n <div class=\"content-container\"><fieldset>\r\n  <h2>404 - File or directory not found.</h2>\r\n  <h3>The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable.</h3>\r\n </fieldset></div>\r\n</div>\r\n</body>\r\n</html>\r\n"}
{"timestamp": "2026-09-22T10:03:34.062933", "query": "SELECT MB.MobileBrand, COUNT(DISTINCT AL.\"DocEntry\") AS InvoicesWithBothPhoneAndAccessory, SUM(AL.\"Quantity\") AS TotalAccessoryUnits, COUNT(DISTINCT OG2.\"ItmsGrpNam\") AS DistinctAccessoryCategories FROM ( SELECT DISTINCT T0.\"DocEntry\", CASE WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-VIVO%' THEN 'VIVO' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-OPPO%' THEN 'OPPO' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-XIAOMI%' THEN 'XIAOMI' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-SAMSUNG%' THEN 'SAMSUNG' WHEN OG.\"ItmsGrpNam\" LIKE 'MOB-APPLE%' THEN 'APPLE' END AS MobileBrand FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OITM T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN OITB OG ON T2.\"ItmsGrpCod\" = OG.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND ( OG.\"ItmsGrpNam\" LIKE 'MOB-VIVO%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-OPPO%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-XIAOMI%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-SAMSUNG%' OR OG.\"ItmsGrpNam\" LIKE 'MOB-APPLE%' ) ) MB INNER JOIN INV1 AL ON MB.\"DocEntry\" = AL.\"DocEntry\" INNER JOIN OITM IT2 ON AL.\"ItemCode\" = IT2.\"ItemCode\" INNER JOIN OITB OG2 ON IT2.\"ItmsGrpCod\" = OG2.\"ItmsGrpCod\" WHERE ( OG2.\"ItmsGrpNam\" LIKE '%CARRY BAG%' OR OG2.\"ItmsGrpNam\" LIKE '%EARPHONE%' OR OG2.\"ItmsGrpNam\" LIKE '%CHARGER%' OR OG2.\"ItmsGrpNam\" LIKE '%WATCH%' OR OG2.\"ItmsGrpNam\" LIKE '%BUDS%' OR OG2.\"ItmsGrpNam\" LIKE '%TWS%' OR OG2.\"ItmsGrpNam\" LIKE '%BACK COVER%' OR OG2.\"ItmsGrpNam\" LIKE '%SCREEN%' OR OG2.\"ItmsGrpNam\" LIKE '%CABLE%' OR OG2.\"ItmsGrpNam\" LIKE '%POWER BANK%' OR OG2.\"ItmsGrpNam\" LIKE '%INSURANCE%' OR OG2.\"ItmsGrpNam\" LIKE '%BAG PACK%' ) GROUP BY MB.MobileBrand ORDER BY InvoicesWithBothPhoneAndAccessory DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-22T10:24:04.458753", "query": "SELECT YEAR(T0.\"DocDate\") AS SaleYear, 'Pongal (Jan 1-20)' AS FestivalPeriod, COUNT(DISTINCT T0.\"DocNum\") AS TotalInvoices, COUNT(DISTINCT T0.\"CardCode\") AS UniqueCustomers, SUM(T1.\"Quantity\") AS TotalQty, ROUND(SUM(T1.\"LineTotal\"), 2) AS TotalSales, ROUND(SUM(T1.\"GrossProfit\"), 2) AS GrossProfit FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" WHERE T0.\"CANCELED\" = 'N' AND MONTH(T0.\"DocDate\") = 1 AND DAY(T0.\"DocDate\") BETWEEN 1 AND 20 AND YEAR(T0.\"DocDate\") IN (2023, 2024) GROUP BY YEAR(T0.\"DocDate\")", "status": "API_ERROR", "details": "VZone API Error: 403 - {\"status\":403,\"message\":\"invalid column name: T1.GrossProfit: line 1 col 262 (at pos 261)\"}"}
